<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>{% block title %}NEO Drive - Car Configurator{% endblock %}</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Rajdhani:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* ============================================
           RESET & BASE STYLES
        ============================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Rajdhani', sans-serif;
            background: radial-gradient(circle at 20% 50%, #0a0a0a 0%, #0a0a2e 50%, #000000 100%);
            min-height: 100vh;
            color: #ffffff;
            overflow-x: hidden;
            position: relative;
        }

        /* Animated background particles */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                repeating-linear-gradient(90deg, rgba(0, 255, 136, 0.03) 0px, rgba(0, 255, 136, 0.03) 1px, transparent 1px, transparent 100px),
                repeating-linear-gradient(0deg, rgba(0, 255, 136, 0.03) 0px, rgba(0, 255, 136, 0.03) 1px, transparent 1px, transparent 100px);
            pointer-events: none;
            z-index: 0;
        }

        /* ============================================
           GLASSMORPHISM & UTILITIES
        ============================================ */
        .glassmorphism {
            background: rgba(10, 10, 26, 0.6);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            border: 1px solid rgba(0, 255, 136, 0.2);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.2);
            transition: all 0.3s ease;
        }

        .glassmorphism:hover {
            border-color: rgba(0, 255, 136, 0.4);
            box-shadow: 0 8px 32px 0 rgba(0, 255, 136, 0.15);
        }

        .gradient-text {
            background: linear-gradient(135deg, #00ff88, #00bfff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            display: inline-block;
        }

        .text-center { text-align: center; }
        .mt-20 { margin-top: 20px; }
        .mb-20 { margin-bottom: 20px; }

        /* ============================================
           NAVBAR STYLES
        ============================================ */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 40px;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(0, 255, 136, 0.3);
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        .logo {
            font-family: 'Orbitron', monospace;
            font-size: 1.6rem;
            font-weight: 800;
            background: linear-gradient(135deg, #00ff88, #00bfff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-decoration: none;
            letter-spacing: 2px;
            transition: all 0.3s ease;
        }

        .logo:hover {
            text-shadow: 0 0 20px rgba(0, 255, 136, 0.5);
            transform: scale(1.02);
        }

        .nav-links {
            display: flex;
            gap: 30px;
            align-items: center;
            flex-wrap: wrap;
        }

        .nav-links a {
            color: #ffffff;
            text-decoration: none;
            font-family: 'Orbitron', monospace;
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            position: relative;
        }

        .nav-links a::before {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, #00ff88, #00bfff);
            transition: width 0.3s ease;
        }

        .nav-links a:hover::before {
            width: 100%;
        }

        .nav-links a:hover {
            color: #00ff88;
            text-shadow: 0 0 10px rgba(0, 255, 136, 0.3);
        }

        /* ============================================
           BUTTON STYLES
        ============================================ */
        .btn-neon {
            position: relative;
            display: inline-block;
            padding: 15px 35px;
            color: #00ff88;
            text-transform: uppercase;
            letter-spacing: 4px;
            text-decoration: none;
            font-size: 1rem;
            overflow: hidden;
            transition: 0.2s;
            background: none;
            border: none;
            cursor: pointer;
            font-family: 'Orbitron', monospace;
            font-weight: 600;
            border-radius: 5px;
        }

        .btn-neon:hover {
            background: #00ff88;
            color: #0a0a0a;
            box-shadow: 0 0 25px #00ff88, 0 0 50px #00ff88;
            transition-delay: 0s;
        }

        .btn-neon span {
            position: absolute;
            display: block;
        }

        .btn-neon span:nth-child(1) {
            top: 0;
            left: -100%;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #00ff88);
            animation: btn-anim1 1.5s linear infinite;
        }

        .btn-neon span:nth-child(2) {
            top: -100%;
            right: 0;
            width: 2px;
            height: 100%;
            background: linear-gradient(180deg, transparent, #00ff88);
            animation: btn-anim2 1.5s linear infinite;
            animation-delay: 0.375s;
        }

        .btn-neon span:nth-child(3) {
            bottom: 0;
            right: -100%;
            width: 100%;
            height: 2px;
            background: linear-gradient(270deg, transparent, #00ff88);
            animation: btn-anim3 1.5s linear infinite;
            animation-delay: 0.75s;
        }

        .btn-neon span:nth-child(4) {
            bottom: -100%;
            left: 0;
            width: 2px;
            height: 100%;
            background: linear-gradient(360deg, transparent, #00ff88);
            animation: btn-anim4 1.5s linear infinite;
            animation-delay: 1.125s;
        }

        @keyframes btn-anim1 {
            0% { left: -100%; }
            50%, 100% { left: 100%; }
        }

        @keyframes btn-anim2 {
            0% { top: -100%; }
            50%, 100% { top: 100%; }
        }

        @keyframes btn-anim3 {
            0% { right: -100%; }
            50%, 100% { right: 100%; }
        }

        @keyframes btn-anim4 {
            0% { bottom: -100%; }
            50%, 100% { bottom: 100%; }
        }

        .btn-neon-small {
            display: inline-block;
            padding: 8px 20px;
            background: linear-gradient(135deg, #00ff88, #00bfff);
            color: #0a0a0a;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
            transition: all 0.3s ease;
            font-family: 'Orbitron', monospace;
            font-size: 0.85rem;
            border: none;
            cursor: pointer;
        }

        .btn-neon-small:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(0, 255, 136, 0.4);
        }

        /* ============================================
           AUTH (LOGIN/REGISTER) STYLES
        ============================================ */
        .auth-container {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 80vh;
            padding: 40px 20px;
        }

        .auth-card {
            max-width: 500px;
            width: 100%;
            padding: 45px;
            transition: transform 0.3s ease;
            animation: fadeInUp 0.6s ease;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .auth-card:hover {
            transform: translateY(-5px);
        }

        .auth-header {
            text-align: center;
            margin-bottom: 35px;
        }

        .neon-text {
            font-family: 'Orbitron', monospace;
            font-size: 2.2rem;
            font-weight: 700;
            background: linear-gradient(135deg, #00ff88, #00bfff, #00ff88);
            background-size: 200% auto;
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 12px;
            animation: shine 3s linear infinite;
        }

        @keyframes shine {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .subtitle {
            color: #aaa;
            font-size: 1rem;
            letter-spacing: 0.5px;
        }

        .auth-form {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .form-group {
            position: relative;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #ccc;
            font-weight: 600;
            letter-spacing: 1px;
            font-size: 0.9rem;
        }

        .form-input, .form-group input:not([type="checkbox"]) {
            width: 100%;
            padding: 12px 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(0, 255, 136, 0.3);
            border-radius: 10px;
            color: white;
            font-size: 1rem;
            transition: all 0.3s ease;
            font-family: 'Rajdhani', sans-serif;
        }

        .form-input:focus, .form-group input:not([type="checkbox"]):focus {
            outline: none;
            border-color: #00ff88;
            box-shadow: 0 0 15px rgba(0, 255, 136, 0.3);
            background: rgba(255, 255, 255, 0.08);
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .checkbox-group input {
            width: 20px;
            height: 20px;
            cursor: pointer;
        }

        .checkbox-group label {
            margin-bottom: 0;
            cursor: pointer;
        }

        .auth-footer {
            text-align: center;
            margin-top: 25px;
            color: #888;
        }

        .auth-footer a {
            color: #00ff88;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s;
        }

        .auth-footer a:hover {
            color: #00bfff;
        }

        .form-error {
            color: #ff6699;
            font-size: 0.8rem;
            margin-top: 5px;
        }

        /* ============================================
           ALERT & FLASH MESSAGES
        ============================================ */
        .alert {
            padding: 12px 18px;
            border-radius: 10px;
            margin-bottom: 20px;
            text-align: center;
            font-weight: 500;
        }

        .alert-error {
            background: rgba(255, 51, 102, 0.15);
            border: 1px solid #ff3366;
            color: #ff6699;
        }

        .alert-success {
            background: rgba(0, 255, 136, 0.15);
            border: 1px solid #00ff88;
            color: #00ff88;
        }

        .alert-warning {
            background: rgba(255, 193, 7, 0.15);
            border: 1px solid #ffc107;
            color: #ffc107;
        }

        .alert-info {
            background: rgba(0, 191, 255, 0.15);
            border: 1px solid #00bfff;
            color: #00bfff;
        }

        .flash-message {
            position: fixed;
            top: 90px;
            right: 20px;
            padding: 15px 25px;
            border-radius: 12px;
            z-index: 1001;
            animation: slideInRight 0.5s ease;
            max-width: 400px;
            font-weight: 600;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(30px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .flash-success {
            background: rgba(0, 255, 136, 0.2);
            border-left: 4px solid #00ff88;
            color: #00ff88;
        }

        .flash-error {
            background: rgba(255, 51, 102, 0.2);
            border-left: 4px solid #ff3366;
            color: #ff3366;
        }

        .flash-warning {
            background: rgba(255, 193, 7, 0.2);
            border-left: 4px solid #ffc107;
            color: #ffc107;
        }

        .flash-info {
            background: rgba(0, 191, 255, 0.2);
            border-left: 4px solid #00bfff;
            color: #00bfff;
        }

        /* ============================================
           CAR CATALOG STYLES
        ============================================ */
        .catalog-container {
            padding: 40px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .catalog-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .cars-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 30px;
        }

        .car-card {
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
            animation: fadeInUp 0.6s ease;
        }

        .car-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 0 30px rgba(0, 255, 136, 0.2);
        }

        .car-image {
            height: 220px;
            overflow: hidden;
            position: relative;
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1));
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .car-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .car-card:hover .car-img {
            transform: scale(1.05);
        }

        .image-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, rgba(0, 255, 136, 0.1), rgba(0, 191, 255, 0.1));
        }

        .car-icon {
            font-size: 80px;
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        .car-overlay {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(0, 255, 136, 0.2);
            backdrop-filter: blur(5px);
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-family: 'Orbitron', monospace;
            color: #00ff88;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .car-card:hover .car-overlay {
            opacity: 1;
        }

        .car-info {
            padding: 25px;
        }

        .car-brand {
            font-family: 'Orbitron', monospace;
            font-size: 0.9rem;
            color: #00ff88;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 8px;
        }

        .car-model {
            font-family: 'Rajdhani', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 15px;
            color: white;
        }

        .car-price {
            margin: 20px 0;
            padding: 15px 0;
            border-top: 1px solid rgba(0, 255, 136, 0.2);
            border-bottom: 1px solid rgba(0, 255, 136, 0.2);
        }

        .price-label {
            display: block;
            font-size: 0.8rem;
            color: #888;
            margin-bottom: 5px;
        }

        .price-value {
            display: block;
            font-size: 1.8rem;
            font-family: 'Orbitron', monospace;
            color: #00ff88;
            font-weight: bold;
        }

        .btn-configure {
            display: inline-block;
            width: 100%;
            padding: 12px;
            background: linear-gradient(45deg, #00ff88, #00bfff);
            color: #0a0a0a;
            text-align: center;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
            font-family: 'Orbitron', monospace;
            transition: all 0.3s ease;
        }

        .btn-configure:hover {
            transform: scale(1.02);
            box-shadow: 0 0 20px rgba(0, 255, 136, 0.5);
        }

        .no-cars {
            padding: 50px;
            text-align: center;
            grid-column: 1 / -1;
        }

        /* ============================================
           CONFIGURATOR STYLES
        ============================================ */
        .configurator-container {
            padding: 40px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .configurator-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .configurator-grid {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 30px;
        }

        .configurator-options, .configurator-summary {
            padding: 30px;
        }

        .configurator-summary {
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        .option-group {
            margin-bottom: 35px;
            padding-bottom: 25px;
            border-bottom: 1px solid rgba(0, 255, 136, 0.2);
        }

        .option-label {
            display: block;
            font-family: 'Orbitron', monospace;
            font-size: 1.1rem;
            color: #00ff88;
            margin-bottom: 20px;
        }

        .color-swatches {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }

        .color-swatch {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 3px solid transparent;
        }

        .color-swatch:hover {
            transform: scale(1.1);
            box-shadow: 0 0 15px rgba(0, 255, 136, 0.5);
        }

        .color-swatch.active {
            border-color: #00ff88;
            box-shadow: 0 0 20px rgba(0, 255, 136, 0.6);
            transform: scale(1.1);
        }

        .package-options, .interior-options {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .package-option, .interior-option {
            flex: 1;
            min-width: 120px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
            border: 2px solid transparent;
        }

        .package-option:hover, .interior-option:hover {
            background: rgba(0, 255, 136, 0.1);
            transform: translateY(-3px);
        }

        .package-option.active, .interior-option.active {
            border-color: #00ff88;
            background: rgba(0, 255, 136, 0.15);
            box-shadow: 0 0 20px rgba(0, 255, 136, 0.3);
        }

        .package-name, .interior-name {
            font-weight: bold;
            font-size: 1rem;
            margin-bottom: 5px;
        }

        .package-price, .interior-price {
            font-size: 0.8rem;
            color: #00ff88;
        }

        .selected-option {
            margin-top: 10px;
            font-size: 0.9rem;
            color: #888;
            font-style: italic;
        }

        .price-details {
            margin: 25px 0;
        }

        .price-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .price-row.total {
            border-top: 2px solid #00ff88;
            border-bottom: none;
            padding-top: 15px;
            margin-top: 10px;
            font-family: 'Orbitron', monospace;
            font-size: 1.2rem;
            font-weight: bold;
        }

        .btn-save-config {
            width: 100%;
            padding: 15px;
            background: linear-gradient(45deg, #00ff88, #00bfff);
            color: #0a0a0a;
            border: none;
            border-radius: 10px;
            font-family: 'Orbitron', monospace;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-save-config:hover {
            transform: scale(1.02);
            box-shadow: 0 0 25px rgba(0, 255, 136, 0.5);
        }

        /* ============================================
           DASHBOARD STYLES
        ============================================ */
        .dashboard-container {
            padding: 40px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .dashboard-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .dashboard-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .config-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            text-align: center;
            padding: 20px;
            transition: transform 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-number {
            display: block;
            font-size: 2.5rem;
            font-family: 'Orbitron', monospace;
            font-weight: bold;
            color: #00ff88;
        }

        .stat-label {
            display: block;
            font-size: 0.9rem;
            color: #888;
            margin-top: 5px;
        }

        .configurations-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
            gap: 30px;
            margin-top: 30px;
        }

        .config-card {
            padding: 25px;
            transition: transform 0.3s ease;
        }

        .config-card:hover {
            transform: translateY(-5px);
        }

        .config-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(0, 255, 136, 0.2);
        }

        .config-car-name {
            font-family: 'Orbitron', monospace;
            font-size: 1.2rem;
            color: #00ff88;
        }

        .config-status {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: bold;
        }

        .status-pending {
            background: rgba(255, 193, 7, 0.2);
            color: #ffc107;
            border: 1px solid #ffc107;
        }

        .status-confirmed {
            background: rgba(0, 191, 255, 0.2);
            color: #00bfff;
            border: 1px solid #00bfff;
        }

        .status-completed {
            background: rgba(0, 255, 136, 0.2);
            color: #00ff88;
            border: 1px solid #00ff88;
        }

        .status-cancelled {
            background: rgba(255, 51, 102, 0.2);
            color: #ff3366;
            border: 1px solid #ff3366;
        }

        .config-details {
            margin: 20px 0;
        }

        .config-detail {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .config-detail.total {
            border-top: 1px solid rgba(0, 255, 136, 0.3);
            border-bottom: none;
            margin-top: 10px;
            padding-top: 15px;
        }

        .detail-label {
            color: #888;
        }

        .detail-value {
            color: white;
            font-weight: 500;
        }

        .detail-value.price {
            color: #00ff88;
            font-family: 'Orbitron', monospace;
            font-size: 1.1rem;
        }

        .config-footer {
            display: flex;
