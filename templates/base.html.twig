            text-decoration: none;
            border-radius: 10px;
            font-weight: bold;
            font-family: 'Orbitron', monospace;
            transition: all 0.3s ease;
        }

        .btn-hero-secondary:hover {
            background: rgba(0, 255, 136, 0.1);
            transform: translateY(-3px);
        }

        .hero-stats {
            display: flex;
            gap: 40px;
        }

        .stat-item {
            display: flex;
