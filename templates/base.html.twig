        .hero-visual {
            flex: 1;
            position: relative;
            min-height: 400px;
        }

        .floating-cars {
            position: relative;
            height: 100%;
        }

        .car-animation {
            position: absolute;
            font-size: 4rem;
            animation: float 6s ease-in-out infinite;
        }

        .car-1 { top: 20%; left: 20%; animation-delay: 0s; }
        .car-2 { top: 60%; left: 50%; animation-delay: 1s; font-size: 3rem; }
        .car-3 { top: 30%; left: 70%; animation-delay: 2s; font-size: 3.5rem; }
        .car-4 { top: 70%; left: 30%; animation-delay: 3s; font-size: 2.5rem; }

        .features-section, .featured-section {
            padding: 80px 5%;
        }

        .featured-section {
            background: rgba(0, 0, 0, 0.3);
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-badge {
            display: inline-block;
            padding: 5px 12px;
            background: rgba(0, 255, 136, 0.1);
            border: 1px solid rgba(0, 255, 136, 0.3);
            border-radius: 20px;
            font-size: 0.8rem;
            color: #00ff88;
            margin-bottom: 15px;
        }

        .section-title {
            font-family: 'Orbitron', monospace;
            font-size: 2.5rem;
            margin-bottom: 15px;
        }

        .section-subtitle {
            color: #aaa;
            font-size: 1.1rem;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .feature-card {
            padding: 30px;
            text-align: center;
            transition: transform 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-10px);
        }

        .feature-icon {
            width: 70px;
            height: 70px;
            margin: 0 auto 20px;
            background: linear-gradient(135deg, rgba(0, 255, 136, 0.1), rgba(0, 191, 255, 0.1));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: #00ff88;
        }

        .feature-card h3 {
            font-family: 'Orbitron', monospace;
            margin-bottom: 15px;
        }

        .feature-card p {
            color: #aaa;
            line-height: 1.6;
        }

        .featured-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
            margin-bottom: 40px;
        }

        .featured-car-card {
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .featured-car-card:hover {
            transform: translateY(-10px);
        }

        .featured-car-image {
            position: relative;
            height: 250px;
            background: linear-gradient(135deg, rgba(0, 255, 136, 0.05), rgba(0, 191, 255, 0.05));
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .car-badge {
            position: absolute;
            top: 15px;
            left: 15px;
            background: rgba(0, 255, 136, 0.2);
            backdrop-filter: blur(5px);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: bold;
            color: #00ff88;
        }

        .featured-car-info {
            padding: 25px;
        }

        .featured-car-model {
            font-family: 'Orbitron', monospace;
            font-size: 1.3rem;
            margin-bottom: 15px;
        }

        .featured-car-price {
            margin-bottom: 20px;
        }

        .btn-featured {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            width: 100%;
            justify-content: center;
            padding: 12px;
            background: rgba(0, 255, 136, 0.1);
            border: 1px solid rgba(0, 255, 136, 0.3);
            color: #00ff88;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .btn-featured:hover {
            background: rgba(0, 255, 136, 0.2);
            transform: scale(1.02);
        }

        .view-all {
            text-align: center;
        }

        .btn-view-all {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 30px;
            background: transparent;
            border: 2px solid rgba(0, 255, 136, 0.5);
            color: #00ff88;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .btn-view-all:hover {
            background: rgba(0, 255, 136, 0.1);
            transform: scale(1.05);
        }

        .cta-section {
            padding: 80px 5%;
        }

        .cta-content {
            max-width: 800px;
            margin: 0 auto;
            padding: 60px;
            text-align: center;
        }

        .cta-content h2 {
            font-family: 'Orbitron', monospace;
            font-size: 2rem;
            margin-bottom: 15px;
        }

        .cta-content p {
            color: #aaa;
            margin-bottom: 30px;
        }

        .cta-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-cta-primary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 30px;
            background: linear-gradient(135deg, #00ff88, #00bfff);
            color: #0a0a0a;
            text-decoration: none;
            border-radius: 10px;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .btn-cta-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 30px rgba(0, 255, 136, 0.4);
        }

        .btn-cta-secondary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 30px;
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(0, 255, 136, 0.5);
            color: white;
            text-decoration: none;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .btn-cta-secondary:hover {
            background: rgba(0, 255, 136, 0.1);
            transform: translateY(-3px);
        }

        /* ============================================
           SCROLLBAR & LOADING
        ============================================ */
        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #1a1a2e;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(135deg, #00ff88, #00bfff);
            border-radius: 5px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(135deg, #00ffaa, #00ccff);
        }

        .loading {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 9999;
        }

        /* ============================================
           RESPONSIVE DESIGN
        ============================================ */
        @media (max-width: 968px) {
            .navbar {
                padding: 15px 20px;
                flex-direction: column;
                gap: 15px;
            }
            
            .nav-links {
                gap: 20px;
                justify-content: center;
            }
            
            .hero-section {
                flex-direction: column;
                text-align: center;
                padding-top: 50px;
            }
            
            .hero-title {
                font-size: 2.5rem;
            }
            
            .hero-buttons {
                justify-content: center;
            }
            
            .hero-stats {
                justify-content: center;
            }
            
            .hero-visual {
                margin-top: 50px;
                min-height: 300px;
            }
            
            .configurator-grid {
                grid-template-columns: 1fr;
            }
            
            .configurator-summary {
                position: static;
            }
            
            .configurations-grid {
                grid-template-columns: 1fr;
            }
            
            .catalog-container,
            .dashboard-container,
            .configurator-container {
                padding: 20px;
            }
            
            .section-title {
                font-size: 1.8rem;
            }
            
            .features-grid,
            .featured-grid {
                grid-template-columns: 1fr;
            }
            
            .cta-content {
                padding: 30px 20px;
            }
            
            .flash-message {
                top: auto;
                bottom: 20px;
                right: 10px;
                left: 10px;
                max-width: none;
            }
        }
        .hero-visual {
    flex: 1;
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Slideshow Styles */
.car-slideshow {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
}

.slideshow-container {
    position: relative;
    height: 420px;
    overflow: hidden;
    border-radius: 25px;
    background: linear-gradient(135deg, rgba(0, 255, 136, 0.08), rgba(0, 191, 255, 0.08));
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

.slide {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.slide-image {
    max-width: 85%;
    max-height: 85%;
    object-fit: contain;
    filter: drop-shadow(0 0 25px rgba(0, 255, 136, 0.4));
    transition: all 0.5s ease;
}

.slide-image:hover {
    transform: scale(1.03);
    filter: drop-shadow(0 0 35px rgba(0, 255, 136, 0.6));
}

/* Fade animation */
.fade {
    animation-name: fade;
    animation-duration: 1.2s;
}

@keyframes fade {
    from { 
        opacity: 0.4; 
        transform: scale(0.95);
    }
    to { 
        opacity: 1; 
        transform: scale(1);
    }
}

/* Dots navigation */
.slideshow-dots {
    text-align: center;
    margin-top: 20px;
}

.dot {
    cursor: pointer;
    height: 10px;
    width: 10px;
    margin: 0 6px;
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    display: inline-block;
    transition: all 0.3s ease;
}

.dot:hover {
    background-color: rgba(0, 255, 136, 0.8);
    transform: scale(1.2);
}

.dot.active {
    background-color: #00ff88;
    box-shadow: 0 0 12px #00ff88;
    transform: scale(1.3);
}

@media (max-width: 768px) {
    .hero-visual {
        min-height: 320px;
    }
    
    .slideshow-container {
        height: 250px;
    }
    
    .slide-image {
        max-width: 80%;
        max-height: 80%;
    }
}
    </style>
</head>
<body>
    <nav class="navbar">
        <a href="{{ path('app_home') }}" class="logo">
            <i class="fas fa-car"></i> NEO DRIVE
        </a>
        <div class="nav-links">
            <a href="{{ path('app_home') }}"><i class="fas fa-home"></i> Home</a>
            <a href="{{ path('app_car_catalog') }}"><i class="fas fa-search"></i> Explore</a>
            {% if app.user %}
                <a href="{{ path('app_dashboard') }}"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                <a href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt"></i> Logout</a>
            {% else %}
                <a href="{{ path('app_login') }}"><i class="fas fa-sign-in-alt"></i> Sign In</a>
                <a href="{{ path('app_register') }}"><i class="fas fa-user-plus"></i> Sign Up</a>
            {% endif %}
        </div>
    </nav>

    <!-- Floating Flash Messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-message flash-{{ label }}">
                <i class="fas {% if label == 'success' %}fa-check-circle{% elseif label == 'error' %}fa-exclamation-circle{% elseif label == 'warning' %}fa-exclamation-triangle{% else %}fa-info-circle{% endif %}"></i>
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <main>
        {% block body %}{% endblock %}
    </main>

    <!-- Loading Spinner -->
    <div class="loading" id="loading">
        <div class="glassmorphism" style="padding: 20px;">
            <i class="fas fa-spinner fa-spin fa-2x" style="color: #00ff88;"></i>
            <p>Processing...</p>
        </div>
    </div>

    <script>
        // Auto-hide flash messages after 5 seconds
        setTimeout(function() {
            document.querySelectorAll('.flash-message').forEach(function(flash) {
                flash.style.opacity = '0';
                setTimeout(function() {
                    if(flash.parentNode) flash.remove();
                }, 500);
            });
        }, 5000);

        // Show loading spinner on form submits
        document.querySelectorAll('form').forEach(function(form) {
            form.addEventListener('submit', function() {
                document.getElementById('loading').style.display = 'block';
            });
        });
    </script>
</body>
</html>