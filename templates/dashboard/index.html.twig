{% extends 'base.html.twig' %}

{% block title %}Dashboard - Car Configurator{% endblock %}

{% block body %}
<div class="dashboard-container">
    <div class="dashboard-header">
        <h1 class="neon-text">Welcome, {{ app.user.name }}!</h1>
        <p>Manage your car configurations</p>
        <div class="dashboard-actions">
            <a href="{{ path('app_car_catalog') }}" class="btn-neon-small">+ New Configuration</a>
            <a href="{{ path('app_logout') }}" class="btn-neon-small" style="background: linear-gradient(45deg, #ff3366, #ff0066);">Logout</a>
        </div>
    </div>
    
    {# Flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
    
    {% if not app.user.isVerified %}
        <div class="alert alert-warning glassmorphism">
            <strong>⚠️ Email not verified!</strong> 
            Please verify your email address.
            <a href="{{ path('app_verify_resend') }}">Resend verification email</a>
        </div>
    {% endif %}
    
    {% if configurations is empty %}
        <div class="coming-soon glassmorphism">
            <h2>🚗 No Configurations Yet</h2>
            <p>Start by configuring your dream car!</p>
            <a href="{{ path('app_car_catalog') }}" class="btn-neon-small">Browse Cars</a>
        </div>
    {% else %}
        <div class="config-stats">
            <div class="stat-card glassmorphism">
                <span class="stat-number">{{ configurations|length }}</span>
                <span class="stat-label">Total Configurations</span>
            </div>
            <div class="stat-card glassmorphism">
                <span class="stat-number">{{ configurations|filter(c => c.status == 'Pending')|length }}</span>
                <span class="stat-label">Pending</span>
            </div>
            <div class="stat-card glassmorphism">
                <span class="stat-number">{{ configurations|filter(c => c.status == 'Confirmed')|length }}</span>
                <span class="stat-label">Confirmed</span>
            </div>
        </div>
        
        <div class="configurations-grid">
            {% for config in configurations %}
                <div class="config-card glassmorphism">
                    <div class="config-header">
                        <h3 class="config-car-name">{{ config.car.brand }} {{ config.car.model }}</h3>
                        <span class="config-status status-{{ config.status|lower }}">
                            {{ config.status }}
                        </span>
                    </div>
                    
                    <div class="config-details">
                        <div class="config-detail">
                            <span class="detail-label">🎨 Color:</span>
                            <span class="detail-value">{{ config.color }}</span>
                        </div>
                        <div class="config-detail">
                            <span class="detail-label">⚡ Package:</span>
                            <span class="detail-value">{{ config.designPackage }}</span>
                        </div>
                        <div class="config-detail">
                            <span class="detail-label">🪑 Interior:</span>
                            <span class="detail-value">{{ config.interior }}</span>
                        </div>
                        <div class="config-detail total">
                            <span class="detail-label">💰 Total Price:</span>
                            <span class="detail-value price">{{ config.formattedTotalPrice }}</span>
                        </div>
                    </div>
                    
                    <div class="config-footer">
                        <div class="config-date">
                            <small>Created: {{ config.createdAt|date('Y-m-d H:i') }}</small>
                        </div>
                        <div class="config-actions">
                            {# Status update dropdown #}
                            {% if config.status == 'Pending' %}
                                <form method="POST" action="{{ path('app_update_configuration_status', {'id': config.id, 'status': 'Confirmed'}) }}" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('status' ~ config.id) }}">
                                    <button type="submit" class="btn-action btn-confirm">✓ Confirm</button>
                                </form>
                            {% endif %}
                            
                            {% if config.status == 'Confirmed' %}
                                <form method="POST" action="{{ path('app_update_configuration_status', {'id': config.id, 'status': 'Completed'}) }}" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('status' ~ config.id) }}">
                                    <button type="submit" class="btn-action btn-complete">✔ Complete</button>
                                </form>
                            {% endif %}
                            
                            {% if config.status == 'Pending' %}
                                <form method="POST" action="{{ path('app_update_configuration_status', {'id': config.id, 'status': 'Cancelled'}) }}" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('status' ~ config.id) }}">
                                    <button type="submit" class="btn-action btn-cancel">✗ Cancel</button>
                                </form>
                            {% endif %}
                            
                            {# Delete button #}
                            <form method="POST" action="{{ path('app_delete_configuration', {'id': config.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this configuration?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ config.id) }}">
                                <button type="submit" class="btn-action btn-delete">🗑 Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}