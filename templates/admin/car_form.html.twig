{% extends 'base.html.twig' %}

{% block title %}{{ is_edit ? 'Edit' : 'Add' }} Car - Admin{% endblock %}

{% block body %}
<div class="admin-container">
    <div class="admin-header">
        <h1 class="neon-text"><i class="fas fa-{{ is_edit ? 'edit' : 'plus' }}"></i> {{ is_edit ? 'Edit' : 'Add' }} Car</h1>
        <p>{{ is_edit ? 'Modify car details' : 'Add a new car to the catalog' }}</p>
    </div>
    
    <div class="form-container glassmorphism">
        {{ form_start(form, {'attr': {'class': 'admin-form'}}) }}
            
            <div class="form-group">
                {{ form_label(form.brand) }}
                {{ form_widget(form.brand) }}
                {{ form_errors(form.brand) }}
            </div>
            
            <div class="form-group">
                {{ form_label(form.model) }}
                {{ form_widget(form.model) }}
                {{ form_errors(form.model) }}
            </div>
            
            <div class="form-group">
                {{ form_label(form.basePrice) }}
                {{ form_widget(form.basePrice) }}
                {{ form_errors(form.basePrice) }}
                <small style="color: #888;">Enter price in USD (e.g., 42000 for $42,000)</small>
            </div>
            
            <div class="form-group">
                {{ form_label(form.image) }}
                {{ form_widget(form.image) }}
                {{ form_errors(form.image) }}
                <small style="color: #888;">Enter image filename (e.g., bmw-3series.jpg). Place image in /public/uploads/cars/</small>
            </div>
            
            <div class="form-actions">
                <button type="submit" class="btn-submit">
                    <i class="fas fa-{{ is_edit ? 'save' : 'plus' }}"></i> {{ is_edit ? 'Update Car' : 'Add Car' }}
                </button>
                <a href="{{ path('app_admin_cars') }}" class="btn-cancel">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
            
        {{ form_end(form) }}
    </div>
</div>

<style>
    .form-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 40px;
    }
    
    .admin-form {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }
    
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    
    .form-group label {
        font-weight: bold;
        color: #00ff88;
        font-family: 'Orbitron', monospace;
    }
    
    .form-actions {
        display: flex;
        gap: 15px;
        margin-top: 20px;
    }
    
    .btn-submit {
        flex: 1;
        padding: 12px;
        background: linear-gradient(135deg, #00ff88, #00bfff);
        border: none;
        border-radius: 8px;
        color: #0a0a0a;
        font-weight: bold;
        cursor: pointer;
        font-family: 'Orbitron', monospace;
        transition: all 0.3s ease;
    }
    
    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 20px rgba(0, 255, 136, 0.4);
    }
    
    .btn-cancel {
        flex: 1;
        padding: 12px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 8px;
        color: white;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
    }
    
    .btn-cancel:hover {
        background: rgba(255, 51, 102, 0.2);
        border-color: #ff3366;
    }
    
    small {
        font-size: 0.75rem;
    }
</style>
{% endblock %}