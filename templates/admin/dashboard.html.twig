{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - Car Configurator{% endblock %}

{% block body %}
<div class="admin-container">
    <div class="admin-header">
        <h1 class="neon-text"><i class="fas fa-crown"></i> Admin Dashboard</h1>
        <p>Welcome back, {{ app.user.name }}!</p>
    </div>
    
    <div class="admin-stats-grid">
        <div class="stat-card glassmorphism">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div class="stat-info">
                <span class="stat-number">{{ stats.total_users }}</span>
                <span class="stat-label">Total Users</span>
            </div>
        </div>
        
        <div class="stat-card glassmorphism">
            <div class="stat-icon"><i class="fas fa-car"></i></div>
            <div class="stat-info">
                <span class="stat-number">{{ stats.total_cars }}</span>
                <span class="stat-label">Total Cars</span>
            </div>
        </div>
        
        <div class="stat-card glassmorphism">
            <div class="stat-icon"><i class="fas fa-chart-line"></i></div>
            <div class="stat-info">
                <span class="stat-number">{{ stats.total_configurations }}</span>
                <span class="stat-label">Configurations</span>
            </div>
        </div>
        
        <div class="stat-card glassmorphism">
            <div class="stat-icon"><i class="fas fa-clock"></i></div>
            <div class="stat-info">
                <span class="stat-number">{{ stats.pending_configurations }}</span>
                <span class="stat-label">Pending</span>
            </div>
        </div>
    </div>
    
    <div class="admin-grid">
        <div class="admin-section glassmorphism">
            <div class="section-header">
                <h2><i class="fas fa-history"></i> Recent Configurations</h2>
                <a href="{{ path('app_admin_configurations') }}" class="btn-admin-small">View All</a>
            </div>
            
            <div class="admin-table">
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Car</th>
                            <th>Total Price</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for config in recentConfigurations %}
                            <tr>
                                <td>{{ config.user.name }}</td>
                                <td>{{ config.car.brand }} {{ config.car.model }}</td>
                                <td>{{ config.formattedTotalPrice }}</td>
                                <td><span class="status-badge status-{{ config.status|lower }}">{{ config.status }}</span></td>
                                <td>{{ config.createdAt|date('Y-m-d') }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center">No configurations found</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="admin-section glassmorphism">
            <div class="section-header">
                <h2><i class="fas fa-user-plus"></i> Recent Users</h2>
                <a href="{{ path('app_admin_users') }}" class="btn-admin-small">View All</a>
            </div>
            
            <div class="admin-table">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Verified</th>
                            <th>Admin</th>
                            <th>Registered</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in recentUsers %}
                            <tr>
                                <td>{{ user.name }}</td>
                                <td>{{ user.email }}</td>
                                <td>{% if user.isVerified %}<i class="fas fa-check-circle" style="color: #00ff88;"></i>{% else %}<i class="fas fa-times-circle" style="color: #ff3366;"></i>{% endif %}</td>
                                <td>{% if 'ROLE_ADMIN' in user.roles %}<i class="fas fa-crown" style="color: #ffd700;"></i>{% else %}-{% endif %}</td>
                                <td>{{ user.id }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center">No users found</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="admin-actions">
        <a href="{{ path('app_admin_cars') }}" class="btn-admin-primary">
            <i class="fas fa-car"></i> Manage Cars
        </a>
        <a href="{{ path('app_admin_users') }}" class="btn-admin-primary">
            <i class="fas fa-users"></i> Manage Users
        </a>
        <a href="{{ path('app_admin_configurations') }}" class="btn-admin-primary">
            <i class="fas fa-chart-line"></i> View All Configurations
        </a>
    </div>
</div>

<style>
    .admin-container {
        padding: 40px;
        max-width: 1400px;
        margin: 0 auto;
    }
    
    .admin-header {
        text-align: center;
        margin-bottom: 40px;
    }
    
    .admin-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }
    
    .stat-card {
        display: flex;
        align-items: center;
        padding: 20px;
        transition: transform 0.3s ease;
    }
    
    .stat-card:hover {
        transform: translateY(-5px);
    }
    
    .stat-icon {
        width: 60px;
        height: 60px;
        background: rgba(0, 255, 136, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: #00ff88;
        margin-right: 15px;
    }
    
    .stat-info {
        flex: 1;
    }
    
    .stat-number {
        display: block;
        font-size: 2rem;
        font-family: 'Orbitron', monospace;
        font-weight: bold;
        color: #00ff88;
    }
    
    .stat-label {
        display: block;
        font-size: 0.85rem;
        color: #888;
    }
    
    .admin-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
        gap: 30px;
        margin-bottom: 40px;
    }
    
    .admin-section {
        padding: 25px;
    }
    
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid rgba(0, 255, 136, 0.2);
    }
    
    .section-header h2 {
        font-family: 'Orbitron', monospace;
        font-size: 1.2rem;
    }
    
    .btn-admin-small {
        padding: 6px 15px;
        background: rgba(0, 255, 136, 0.1);
        border: 1px solid rgba(0, 255, 136, 0.3);
        border-radius: 5px;
        color: #00ff88;
        text-decoration: none;
        font-size: 0.8rem;
        transition: all 0.3s ease;
    }
    
    .btn-admin-small:hover {
        background: rgba(0, 255, 136, 0.2);
    }
    
    .admin-table {
        overflow-x: auto;
    }
    
    .admin-table table {
        width: 100%;
        border-collapse: collapse;
    }
    
    .admin-table th,
    .admin-table td {
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    
    .admin-table th {
        color: #00ff88;
        font-weight: bold;
    }
    
    .status-badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: bold;
    }
    
    .status-pending { background: rgba(255, 193, 7, 0.2); color: #ffc107; }
    .status-confirmed { background: rgba(0, 191, 255, 0.2); color: #00bfff; }
    .status-completed { background: rgba(0, 255, 136, 0.2); color: #00ff88; }
    .status-cancelled { background: rgba(255, 51, 102, 0.2); color: #ff3366; }
    
    .admin-actions {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
    }
    
    .btn-admin-primary {
        padding: 12px 30px;
        background: linear-gradient(135deg, #00ff88, #00bfff);
        color: #0a0a0a;
        text-decoration: none;
        border-radius: 10px;
        font-weight: bold;
        transition: all 0.3s ease;
        font-family: 'Orbitron', monospace;
    }
    
    .btn-admin-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 0 20px rgba(0, 255, 136, 0.4);
    }
    
    .text-center {
        text-align: center;
    }
    
    @media (max-width: 768px) {
        .admin-container {
            padding: 20px;
        }
        
        .admin-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}