{% extends 'base.html.twig' %}

{% block title %}Manage Cars - Admin{% endblock %}

{% block body %}
<div class="admin-container">
    <div class="admin-header">
        <h1 class="neon-text"><i class="fas fa-car"></i> Manage Cars</h1>
        <p>Add, edit, or remove cars from the catalog</p>
    </div>
    
    <div class="admin-actions" style="margin-bottom: 30px;">
        <a href="{{ path('app_admin_car_new') }}" class="btn-admin-primary">
            <i class="fas fa-plus"></i> Add New Car
        </a>
        <a href="{{ path('app_admin_dashboard') }}" class="btn-admin-primary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>
    
    <div class="admin-section glassmorphism">
        <div class="admin-table">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Image</th>
                        <th>Brand</th>
                        <th>Model</th>
                        <th>Base Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for car in cars %}
                        <tr>
                            <td>{{ car.id }}</td>
                            <td>
                                {% if car.image %}
                                    <img src="{{ asset('uploads/cars/' ~ car.image) }}" alt="{{ car.model }}" style="width: 50px; height: 35px; object-fit: cover; border-radius: 5px;">
                                {% else %}
                                    <i class="fas fa-car" style="font-size: 30px; color: #888;"></i>
                                {% endif %}
                            </td>
                            <td><strong>{{ car.brand }}</strong></td>
                            <td>{{ car.model }}</td>
                            <td>{{ car.formattedPrice }}</td>
                            <td>
                                <a href="{{ path('app_admin_car_edit', {'id': car.id}) }}" class="btn-edit">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <form method="POST" action="{{ path('app_admin_car_delete', {'id': car.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete {{ car.brand }} {{ car.model }}?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ car.id) }}">
                                    <button type="submit" class="btn-delete">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center">No cars found. <a href="{{ path('app_admin_car_new') }}">Add your first car</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .btn-edit {
        display: inline-block;
        padding: 5px 12px;
        background: rgba(0, 191, 255, 0.2);
        border: 1px solid #00bfff;
        color: #00bfff;
        border-radius: 5px;
        text-decoration: none;
        font-size: 0.8rem;
        margin-right: 5px;
        transition: all 0.3s ease;
    }
    
    .btn-edit:hover {
        background: rgba(0, 191, 255, 0.4);
    }
    
    .btn-delete {
        padding: 5px 12px;
        background: rgba(255, 51, 102, 0.2);
        border: 1px solid #ff3366;
        color: #ff3366;
        border-radius: 5px;
        cursor: pointer;
        font-size: 0.8rem;
        transition: all 0.3s ease;
    }
    
    .btn-delete:hover {
        background: rgba(255, 51, 102, 0.4);
    }
</style>
{% endblock %}