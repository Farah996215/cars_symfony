{% extends 'base.html.twig' %}

{% block title %}NEO Drive - Future of Automotive Configurator{% endblock %}

{% block body %}
<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content">
        <div class="hero-badge glassmorphism">
            <i class="fas fa-microchip"></i> NEXT-GEN CONFIGURATOR
        </div>
        <h1 class="hero-title">
            Design Your<br>
            <span class="gradient-text">Digital Dream</span>
        </h1>
        <p class="hero-subtitle">
            Experience the future of car customization. Configure your perfect machine<br>
            with our AI-powered configurator and drive into tomorrow.
        </p>
        <div class="hero-buttons">
            <a href="{{ path('app_car_catalog') }}" class="btn-hero-primary">
                <i class="fas fa-rocket"></i> Start Configuring
            </a>
            <a href="#features" class="btn-hero-secondary">
                <i class="fas fa-play"></i> Explore Features
            </a>
        </div>
        
        <div class="hero-stats">
            <div class="stat-item">
                <span class="stat-number">7+</span>
                <span class="stat-label">Premium Models</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">50+</span>
                <span class="stat-label">Config Options</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">100%</span>
                <span class="stat-label">Customizable</span>
            </div>
        </div>
    </div>
    
    <div class="hero-visual">
        <div class="car-slideshow">
            <div class="slideshow-container">
                <div class="slide fade">
                    <img src="{{ asset('uploads/cars/1.png') }}" alt="Porsche 911" class="slide-image" onerror="this.src='https://placehold.co/600x400/1a1a2e/00ff88?text=Porsche+911'">
                </div>
                <div class="slide fade">
                    <img src="{{ asset('uploads/cars/2.png') }}" alt="BMW 3 Series" class="slide-image" onerror="this.src='https://placehold.co/600x400/1a1a2e/00ff88?text=BMW+3+Series'">
                </div>
                <div class="slide fade">
                    <img src="{{ asset('uploads/cars/3.png') }}" alt="Audi A3" class="slide-image" onerror="this.src='https://placehold.co/600x400/1a1a2e/00ff88?text=Audi+A3'">
                </div>
                <div class="slide fade">
                    <img src="{{ asset('uploads/cars/4.png') }}" alt="Volkswagen Golf" class="slide-image" onerror="this.src='https://placehold.co/600x400/1a1a2e/00ff88?text=Volkswagen+Golf'">
                </div>
                <div class="slide fade">
                    <img src="{{ asset('uploads/cars/5.png') }}" alt="MINI Cooper" class="slide-image" onerror="this.src='https://placehold.co/600x400/1a1a2e/00ff88?text=MINI+Cooper'">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="features-section">
    <div class="container">
        <div class="section-header">
            <span class="section-badge">WHY CHOOSE US</span>
            <h2 class="section-title">Experience the <span class="gradient-text">Future</span></h2>
            <p class="section-subtitle">Revolutionary features that put you in control</p>
        </div>
        
        <div class="features-grid">
            <div class="feature-card glassmorphism">
                <div class="feature-icon">
                    <i class="fas fa-sliders-h"></i>
                </div>
                <h3>Real-time Configurator</h3>
                <p>Watch prices update instantly as you choose colors, packages, and interiors</p>
            </div>
            
            <div class="feature-card glassmorphism">
                <div class="feature-icon">
                    <i class="fas fa-cloud-upload-alt"></i>
                </div>
                <h3>Save Your Builds</h3>
                <p>Save unlimited configurations and access them from your personal dashboard</p>
            </div>
            
            <div class="feature-card glassmorphism">
                <div class="feature-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h3>Live Pricing</h3>
                <p>See exactly how your choices affect the final price in real-time</p>
            </div>
            
            <div class="feature-card glassmorphism">
                <div class="feature-icon">
                    <i class="fas fa-palette"></i>
                </div>
                <h3>Custom Colors</h3>
                <p>Choose from premium colors with exclusive finishes</p>
            </div>
            
            <div class="feature-card glassmorphism">
                <div class="feature-icon">
                    <i class="fas fa-tachometer-alt"></i>
                </div>
                <h3>Performance Packages</h3>
                <p>Upgrade to Sport or Luxury packages for enhanced performance</p>
            </div>
            
            <div class="feature-card glassmorphism">
                <div class="feature-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h3>Secure Platform</h3>
                <p>Your data is protected with enterprise-grade security</p>
            </div>
        </div>
    </div>
</section>

<!-- Featured Cars Section -->
<section class="featured-section">
    <div class="container">
        <div class="section-header">
            <span class="section-badge">FEATURED MODELS</span>
            <h2 class="section-title">Popular <span class="gradient-text">Configurations</span></h2>
            <p class="section-subtitle">Explore our most sought-after vehicles</p>
        </div>
        
        <div class="featured-grid">
            {% for car in featuredCars %}
                <div class="featured-car-card glassmorphism">
                    <div class="featured-car-image">
                        <div class="image-placeholder">
                            <i class="fas fa-car-side car-icon"></i>
                        </div>
                        <div class="car-badge">{{ car.brand }}</div>
                    </div>
                    <div class="featured-car-info">
                        <h3 class="featured-car-model">{{ car.model }}</h3>
                        <div class="featured-car-price">
                            <span class="price-from">Starting from</span>
                            <span class="price-value">{{ car.formattedPrice }}</span>
                        </div>
                        <a href="{{ path('app_car_configurator', {'id': car.id}) }}" class="btn-featured">
                            <i class="fas fa-cog"></i> Configure Now
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
        
        <div class="view-all">
            <a href="{{ path('app_car_catalog') }}" class="btn-view-all">
                View All Models <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section">
    <div class="cta-content glassmorphism">
        <h2>Ready to Build Your Dream Car?</h2>
        <p>Join thousands of enthusiasts who have already configured their perfect machine.</p>
        {% if not app.user %}
            <div class="cta-buttons">
                <a href="{{ path('app_register') }}" class="btn-cta-primary">
                    <i class="fas fa-user-plus"></i> Get Started Free
                </a>
                <a href="{{ path('app_login') }}" class="btn-cta-secondary">
                    <i class="fas fa-sign-in-alt"></i> Sign In
                </a>
            </div>
        {% else %}
            <a href="{{ path('app_car_catalog') }}" class="btn-cta-primary">
                <i class="fas fa-car"></i> Start Configuring
            </a>
        {% endif %}
    </div>
</section>

<style>
    /* Slideshow Styles */
    .car-slideshow {
        position: relative;
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
    }

    .slideshow-container {
        position: relative;
        height: 400px;
        overflow: hidden;
        border-radius: 20px;
        background: linear-gradient(135deg, rgba(0,0,0,0), rgba(0,0,0,0));
    }

    .slide {
        position: absolute;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .slide-image {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 0 20px rgba(0, 255, 136, 0.3));
        transition: transform 0.9s ease;
    }

    .slide-image:hover {
        transform: scale(1.05);
    }

    /* Fade animation */
    .fade {
        animation-name: fade;
        animation-duration: 1.5s;
    }

    @keyframes fade {
        from { opacity: 0.4; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
    /* Responsive */
    @media (max-width: 768px) {
        .slideshow-container {
            height: 250px;
        }
        
        .slide-image {
            max-width: 100%;
            max-height: 100%;
        }
    }
</style>

<script>
    // JavaScript for auto slideshow
    let slideIndex = 0;
    let slides = document.getElementsByClassName("slide");
    let dots = document.getElementsByClassName("dot");
    let autoSlideInterval;

    // Show initial slide
    showSlides();

    // Start auto slideshow
    function startAutoSlide() {
        autoSlideInterval = setInterval(function() {
            slideIndex++;
            if (slideIndex >= slides.length) {
                slideIndex = 0;
            }
            showSlides();
        }, 3000); // Change image every 3 seconds
    }

    // Stop auto slideshow
    function stopAutoSlide() {
        clearInterval(autoSlideInterval);
    }

    // Show current slide
    function showSlides() {
        // Hide all slides
        for (let i = 0; i < slides.length; i++) {
            slides[i].style.display = "none";
        }
        
        // Remove active class from all dots
        for (let i = 0; i < dots.length; i++) {
            dots[i].className = dots[i].className.replace(" active", "");
        }
        
        // Show current slide
        if (slides[slideIndex]) {
            slides[slideIndex].style.display = "flex";
            if (dots[slideIndex]) {
                dots[slideIndex].className += " active";
            }
        }
    }

    // Manual navigation
    function currentSlide(n) {
        stopAutoSlide();
        slideIndex = n - 1;
        showSlides();
        startAutoSlide();
    }

    // Make currentSlide available globally
    window.currentSlide = currentSlide;

    // Start auto slideshow when page loads
    document.addEventListener('DOMContentLoaded', function() {
        startAutoSlide();
        
        // Pause on hover
        const slideshowContainer = document.querySelector('.slideshow-container');
        if (slideshowContainer) {
            slideshowContainer.addEventListener('mouseenter', stopAutoSlide);
            slideshowContainer.addEventListener('mouseleave', startAutoSlide);
        }
    });
</script>
{% endblock %}