{% extends 'base.html.twig' %}

{% block title %}Configure {{ car.brand }} {{ car.model }}{% endblock %}

{% block body %}
<div class="configurator-container">
    <div class="configurator-header">
        <h1 class="neon-text">
            <i class="fas fa-cog fa-spin"></i> 
            Configure Your {{ car.brand }} {{ car.model }}
        </h1>
        <p class="subtitle">Personalize every detail of your machine</p>
    </div>

    <div class="configurator-grid">
        <!-- Left Side: Configuration Options -->
        <div class="configurator-options glassmorphism">
            <h2><i class="fas fa-palette"></i> Customization Studio</h2>
            
            <!-- Color Selection -->
            <div class="option-group">
                <label class="option-label"><i class="fas fa-fill-drip"></i> Exterior Color</label>
                <div class="color-swatches" id="colorSwatches">
                    <div class="color-swatch" data-color="Red" data-price="0" style="background: #ff0000;" title="Red"></div>
                    <div class="color-swatch" data-color="Blue" data-price="0" style="background: #0066ff;" title="Blue"></div>
                    <div class="color-swatch" data-color="Black" data-price="0" style="background: #000000;" title="Black"></div>
                    <div class="color-swatch" data-color="White" data-price="0" style="background: #ffffff;" title="White"></div>
                    <div class="color-swatch" data-color="Silver" data-price="500" style="background: #c0c0c0;" title="Silver (+$500)"></div>
                    <div class="color-swatch" data-color="Gold" data-price="1500" style="background: #ffd700;" title="Gold (+$1500)"></div>
                </div>
                <div class="selected-option" id="selectedColor">
                    <i class="fas fa-tint"></i> Selected: None
                </div>
            </div>

            <!-- Design Package -->
            <div class="option-group">
                <label class="option-label"><i class="fas fa-bolt"></i> Performance Package</label>
                <div class="package-options" id="packageOptions">
                    <div class="package-option" data-package="Standard" data-price="0">
                        <div class="package-name"><i class="fas fa-shield-alt"></i> Standard</div>
                        <div class="package-price">Included</div>
                    </div>
                    <div class="package-option" data-package="Sport" data-price="3000">
                        <div class="package-name"><i class="fas fa-tachometer-alt"></i> Sport</div>
                        <div class="package-price">+$3,000</div>
                    </div>
                    <div class="package-option" data-package="Luxury" data-price="5000">
                        <div class="package-name"><i class="fas fa-crown"></i> Luxury</div>
                        <div class="package-price">+$5,000</div>
                    </div>
                </div>
                <div class="selected-option" id="selectedPackage">
                    <i class="fas fa-cube"></i> Selected: None
                </div>
            </div>

            <!-- Interior Style -->
            <div class="option-group">
                <label class="option-label"><i class="fas fa-couch"></i> Interior Design</label>
                <div class="interior-options" id="interiorOptions">
                    <div class="interior-option" data-interior="Black Leather" data-price="0">
                        <div class="interior-name"><i class="fas fa-chair"></i> Black Leather</div>
                        <div class="interior-price">Included</div>
                    </div>
                    <div class="interior-option" data-interior="Beige Leather" data-price="800">
                        <div class="interior-name"><i class="fas fa-chair"></i> Beige Leather</div>
                        <div class="interior-price">+$800</div>
                    </div>
                    <div class="interior-option" data-interior="Red Sport" data-price="1200">
                        <div class="interior-name"><i class="fas fa-racing-flag"></i> Red Sport</div>
                        <div class="interior-price">+$1,200</div>
                    </div>
                    <div class="interior-option" data-interior="Carbon Fiber" data-price="2500">
                        <div class="interior-name"><i class="fas fa-microchip"></i> Carbon Fiber</div>
                        <div class="interior-price">+$2,500</div>
                    </div>
                </div>
                <div class="selected-option" id="selectedInterior">
                    <i class="fas fa-undo-alt"></i> Selected: None
                </div>
            </div>
        </div>

        <!-- Right Side: Price Summary -->
        <div class="configurator-summary glassmorphism">
            <h2><i class="fas fa-chart-line"></i> Investment Summary</h2>
            
            <div class="price-details">
                <div class="price-row">
                    <span><i class="fas fa-car"></i> Base Price:</span>
                    <span id="basePrice">{{ car.formattedPrice }}</span>
                </div>
                <div class="price-row">
                    <span><i class="fas fa-palette"></i> Color (<span id="colorName">-</span>):</span>
                    <span id="colorPrice">$0</span>
                </div>
                <div class="price-row">
                    <span><i class="fas fa-bolt"></i> Package (<span id="packageName">-</span>):</span>
                    <span id="packagePrice">$0</span>
                </div>
                <div class="price-row">
                    <span><i class="fas fa-couch"></i> Interior (<span id="interiorName">-</span>):</span>
                    <span id="interiorPrice">$0</span>
                </div>
                <div class="price-row total">
                    <span><i class="fas fa-tag"></i> Total Investment:</span>
                    <span id="totalPrice">{{ car.formattedPrice }}</span>
                </div>
            </div>

            <button class="btn-save-config" id="saveConfigBtn">
                <i class="fas fa-save"></i> Save Configuration
            </button>
            <p class="text-center mt-20" style="font-size: 0.8rem; color: #666;">
                <i class="fas fa-lock"></i> Your configuration is securely saved
            </p>
        </div>
    </div>
</div>

{% block javascripts %}
<script>
    // Configuration state
    let config = {
        color: { name: null, price: 0 },
        package: { name: null, price: 0 },
        interior: { name: null, price: 0 }
    };
    
    const basePrice = {{ car.basePrice }};
    const carId = {{ car.id }};
    
    function updateTotalPrice() {
        const total = basePrice + config.color.price + config.package.price + config.interior.price;
        const formattedTotal = '$' + total.toLocaleString('en-US');
        
        document.getElementById('totalPrice').textContent = formattedTotal;
        document.getElementById('colorPrice').textContent = config.color.price > 0 ? '+$' + config.color.price.toLocaleString() : '$0';
        document.getElementById('packagePrice').textContent = config.package.price > 0 ? '+$' + config.package.price.toLocaleString() : '$0';
        document.getElementById('interiorPrice').textContent = config.interior.price > 0 ? '+$' + config.interior.price.toLocaleString() : '$0';
        
        document.getElementById('colorName').textContent = config.color.name || '-';
        document.getElementById('packageName').textContent = config.package.name || '-';
        document.getElementById('interiorName').textContent = config.interior.name || '-';
    }
    
    // Color selection
    document.querySelectorAll('.color-swatch').forEach(swatch => {
        swatch.addEventListener('click', function() {
            document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
            this.classList.add('active');
            
            config.color = {
                name: this.dataset.color,
                price: parseInt(this.dataset.price) || 0
            };
            
            document.getElementById('selectedColor').innerHTML = `<i class="fas fa-tint"></i> Selected: ${config.color.name} ${config.color.price > 0 ? '(+$${config.color.price})' : ''}`;
            updateTotalPrice();
        });
    });
    
    // Package selection
    document.querySelectorAll('.package-option').forEach(pkg => {
        pkg.addEventListener('click', function() {
            document.querySelectorAll('.package-option').forEach(p => p.classList.remove('active'));
            this.classList.add('active');
            
            config.package = {
                name: this.dataset.package,
                price: parseInt(this.dataset.price) || 0
            };
            
            document.getElementById('selectedPackage').innerHTML = `<i class="fas fa-cube"></i> Selected: ${config.package.name} ${config.package.price > 0 ? '(+$${config.package.price})' : ''}`;
            updateTotalPrice();
        });
    });
    
    // Interior selection
    document.querySelectorAll('.interior-option').forEach(interior => {
        interior.addEventListener('click', function() {
            document.querySelectorAll('.interior-option').forEach(i => i.classList.remove('active'));
            this.classList.add('active');
            
            config.interior = {
                name: this.dataset.interior,
                price: parseInt(this.dataset.price) || 0
            };
            
            document.getElementById('selectedInterior').innerHTML = `<i class="fas fa-undo-alt"></i> Selected: ${config.interior.name} ${config.interior.price > 0 ? '(+$${config.interior.price})' : ''}`;
            updateTotalPrice();
        });
    });
    
    // Save configuration
    document.getElementById('saveConfigBtn').addEventListener('click', async function() {
        if (!config.color.name || !config.package.name || !config.interior.name) {
            alert('⚠️ Please select a color, package, and interior style before saving!');
            return;
        }
        
        const totalPrice = basePrice + config.color.price + config.package.price + config.interior.price;
        
        const configurationData = {
            color: config.color,
            package: config.package,
            interior: config.interior,
            totalPrice: totalPrice
        };
        
        document.getElementById('loading').style.display = 'block';
        
        try {
            const response = await fetch(`/configure/save/${carId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(configurationData)
            });
            
            const result = await response.json();
            
            if (result.success) {
                alert('✅ Configuration saved successfully! Redirecting to dashboard...');
                window.location.href = '{{ path("app_dashboard") }}';
            } else {
                alert('❌ Error: ' + (result.error || 'Could not save configuration'));
            }
        } catch (error) {
            console.error('Error saving configuration:', error);
            alert('❌ An error occurred while saving. Please try again.');
        } finally {
            document.getElementById('loading').style.display = 'none';
        }
    });
</script>
{% endblock %}
{% endblock %}